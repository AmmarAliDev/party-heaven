{
  "name": "party-heaven-official",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm prisma:generate",
    "build": "next build",
    "build:deploy": "node scripts/guard-deploy-workflow.mjs && pnpm prisma:generate && pnpm prisma:migrate:deploy && next build",
    "build:production": "pnpm build:deploy",
    "start": "next start",
    "prisma:generate": "node scripts/prisma-cli.mjs generate",
    "prisma:validate": "node scripts/prisma-cli.mjs validate",
    "prisma:migrate:status": "node scripts/prisma-cli.mjs migrate status",
    "prisma:migrate:dev": "node scripts/prisma-cli.mjs migrate dev",
    "prisma:migrate:dev:safe": "node scripts/prisma-cli.mjs migrate dev --create-only",
    "prisma:migrate:deploy": "node scripts/prisma-cli.mjs migrate deploy",
    "prisma:migrate:resolve": "node scripts/prisma-cli.mjs migrate resolve",
    "prisma:studio": "node scripts/prisma-cli.mjs studio",
    "prisma:seed": "node prisma/seed.js",
    "prisma:seed:dev-catalog": "node prisma/populate-dev-catalog.js",
    "prisma:seed:production-catalog": "node prisma/populate-production-catalog.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.15.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.7",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "react-infinite-scroll-component": "^7.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^5.15.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
