// Prisma schema for Party Heaven single-vendor e-commerce
// Design goals:
// - Single vendor, Pakistan-only (Karachi initially)
// - Inventory tracked per ProductVariant
// - Guest checkout supported (Order.userId nullable + address snapshots)
// - Admin role types: super admin, product manager, order manager
// - SEO fields included on key content models
// - Designed for incremental migration: payments/referrals/loyalty/localization later

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// Region and currency enums (small scoped for initial launch)
enum Country {
  PAK

  @@map("country")
}

enum City {
  KARACHI

  @@map("city")
}

// Role and permission model keys
enum RoleKey {
  SUPER_ADMIN
  PRODUCT_MANAGER
  ORDER_MANAGER
  CUSTOMER
  GUEST

  @@map("role_key")
}

// Product / Order / Cart statuses
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("product_status")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN

  @@map("review_status")
}

// Deal lifecycle mirrors Product so admins can stage deals before publishing.
enum DealStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("deal_status")
}

enum CategoryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("blog_post_status")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum RefundStatus {
  NONE
  PENDING
  COMPLETED
  REVERSED
}

enum CartStatus {
  ACTIVE
  COMPLETED
  ABANDONED

  @@map("cart_status")
}

// Email subscriber lifecycle — drives double opt-in and list hygiene.
enum SubscriberStatus {
  PENDING      // Awaiting confirmation (double opt-in flow — deferred)
  ACTIVE       // Confirmed, actively subscribed
  UNSUBSCRIBED // User opted out via unsubscribe link or preference centre
  BOUNCED      // Hard bounce reported by sending provider; do not re-send

  @@map("subscriber_status")
}

// Append-only event types for the abandoned cart detection pipeline.
// The background job that evaluates these events is deferred (future automation).
enum AbandonedCartEventType {
  CART_CREATED     // First item added — starts the abandonment clock
  CART_UPDATED     // Item added, removed, or quantity changed
  REMINDER_QUEUED  // Recovery email job has been queued for delivery
  REMINDER_SENT    // Recovery email was successfully delivered
  CART_RECOVERED   // Customer returned and completed checkout
  CART_EXPIRED     // Cart was archived without recovery

  @@map("abandoned_cart_event_type")
}

// Currency (Pakistan Rupee only for now)
enum Currency {
  PKR

  @@map("currency")
}

// --------------------
// Core models
// --------------------

model Role {
  id          String   @id @default(uuid())
  key         RoleKey  @unique
  name        String
  // permissions JSON allows fine-grained flags per role (feature-forward)
  permissions Json     @default("{}")
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

model User {
  id            String     @id @default(uuid())
  // email is nullable so OAuth providers that don't expose email still work
  email         String?    @unique
  emailVerified DateTime?  // set by NextAuth adapter after email verification
  image         String?    // profile picture URL (from OAuth provider)
  password      String?    // bcrypt hash; null for OAuth-only accounts
  phone         String?    @unique
  name          String?
  role          Role?      @relation(fields: [roleId], references: [id])
  roleId        String?    @map("role_id")
  accounts      Account[]
  sessions      Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  addresses        Address[]
  reviews          Review[]   @relation("AuthorReviews")
  moderatedReviews Review[]   @relation("ModeratedReviews")
  wishlists        Wishlist[]
  carts            Cart[]
  orders        Order[]
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
}

// NextAuth compatible Account + Session models (optional for NextAuth)
model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id])
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId])
}

model Address {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @map("user_id")
  label     String? // Home, Office, etc.
  country   Country  @default(PAK)
  province  String?
  city      City     @default(KARACHI)
  postcode  String?
  street1   String
  street2   String?
  phone     String?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
}

model Category {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  description    String?
  cardImageUrl   String?        @map("card_image_url")
  status         CategoryStatus @default(DRAFT)
  parentId       String?        @map("parent_id")
  parent         Category?      @relation("CategoryToCategory", fields: [parentId], references: [id])
  children       Category[]     @relation("CategoryToCategory")
  products         Product[]
  deals            Deal[]
  seoTitle         String?        @map("seo_title")
  seoDescription   String?        @map("seo_description")
  seoCanonicalUrl  String?        @map("seo_canonical_url")
  seoOgTitle       String?        @map("seo_og_title")
  seoOgDescription String?        @map("seo_og_description")
  seoImageUrl      String?        @map("seo_image_url")
  seoKeywords      String?        @map("seo_keywords")
  seoNoIndex       Boolean        @default(false) @map("seo_no_index")
  seoSchemaNotes   String?        @map("seo_schema_notes")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([slug])
  @@index([status])
}

model BlogPost {
  id               String         @id @default(uuid())
  locale           String         @default("en")
  title            String
  slug             String
  excerpt          String
  content          Json
  coverImageUrl    String?        @map("cover_image_url")
  coverImageAlt    String?        @map("cover_image_alt")
  coverImageWidth  Int?           @map("cover_image_width")
  coverImageHeight Int?           @map("cover_image_height")
  status           BlogPostStatus @default(DRAFT)
  publishedAt      DateTime?      @map("published_at")
  seoTitle         String?        @map("seo_title")
  seoDescription   String?        @map("seo_description")
  seoCanonicalUrl  String?        @map("seo_canonical_url")
  seoOgTitle       String?        @map("seo_og_title")
  seoOgDescription String?        @map("seo_og_description")
  seoImageUrl      String?        @map("seo_image_url")
  seoKeywords      String?        @map("seo_keywords")
  seoNoIndex       Boolean        @default(false) @map("seo_no_index")
  seoSchemaNotes   String?        @map("seo_schema_notes")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@index([publishedAt])
  @@index([locale, status])
  @@unique([locale, slug])
  @@map("blog_post")
}

model Product {
  id               String                 @id @default(uuid())
  // Optional master product code (parent identifier). Actual SKU for
  // inventory/fulfillment lives on `ProductVariant.sku`.
  masterSku        String?                @map("master_sku")
  name             String
  slug             String                 @unique
  shortDescription String?                @map("short_description")
  description      String?
  status           ProductStatus          @default(DRAFT)
  categoryId       String?                @map("category_id")
  category         Category?              @relation(fields: [categoryId], references: [id])
  weightGram       Int?                   @map("weight_gram")
  heightMm         Int?                   @map("height_mm")
  widthMm          Int?                   @map("width_mm")
  depthMm          Int?                   @map("depth_mm")
  images           ProductImage[]
  variants         ProductVariant[]
  specifications   ProductSpecification[]
  reviews          Review[]
  dealCampaigns    DealCampaignProduct[]
  dealProducts     DealProduct[]
  metadata         Json?
  seoTitle         String?                @map("seo_title")
  seoDescription   String?                @map("seo_description")
  seoCanonicalUrl  String?                @map("seo_canonical_url")
  seoOgTitle       String?                @map("seo_og_title")
  seoOgDescription String?                @map("seo_og_description")
  seoImageUrl      String?                @map("seo_image_url")
  seoKeywords      String?                @map("seo_keywords")
  seoNoIndex       Boolean                @default(false) @map("seo_no_index")
  seoSchemaNotes   String?                @map("seo_schema_notes")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([masterSku])
}

model ProductImage {
  id               String          @id @default(uuid())
  product          Product?        @relation(fields: [productId], references: [id])
  productId        String?         @map("product_id")
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  productVariantId String?         @map("product_variant_id")
  url              String
  alt              String?
  position         Int             @default(0)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // NOTE: At least one of `productId` or `productVariantId` MUST be set.
  // This is enforced by a DB CHECK constraint in the migration (product_id IS NOT NULL OR product_variant_id IS NOT NULL).
  @@index([productId, position])
}

model ProductVariant {
  id             String         @id @default(uuid())
  product        Product        @relation(fields: [productId], references: [id])
  productId      String         @map("product_id")
  sku            String?        @unique
  title          String?
  options        Json? // e.g. { color: 'red', size: 'M' }
  price          Int // stored in smallest currency unit (PKR paisa)
  compareAtPrice Int?           @map("compare_at_price")
  currency       Currency       @default(PKR)
  inventory      Inventory?
  images         ProductImage[]
  wishlistItems  WishlistItem[]
  cartItems      CartItem[]
  dealProducts   DealProduct[]
  isDefault      Boolean        @default(false) @map("is_default")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([productId])
}

model Inventory {
  id               String         @id @default(uuid())
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String         @unique @map("product_variant_id")
  quantity         Int            @default(0)
  reserved         Int            @default(0)
  location         City           @default(KARACHI)
  safetyStock      Int            @default(0) @map("safety_stock")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
}

// ---------------------------------------------------------------------------
// Featured deals
// ---------------------------------------------------------------------------
// A Deal bundles multiple catalog products (each with its own quantity, and
// optionally a specific variant) under deal-specific media, pricing, and a
// short description. Deals never define their own variant set — availability
// always derives from the included products'/variants' inventory, and a deal
// is considered available when every included product is in stock.
model Deal {
  id               String             @id @default(uuid())
  title            String
  slug             String             @unique
  shortDescription String?            @map("short_description")
  description      String?
  status           DealStatus         @default(DRAFT)
  // The deal's primary category (same as products — a deal belongs to one
  // category and appears on the category's surface when published).
  category         Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId       String?            @map("category_id")
  // Deal-level pricing (stored in smallest currency unit, PKR paisa).
  price            Int                @default(0)
  compareAtPrice   Int?               @map("compare_at_price")
  images           DealImage[]
  products         DealProduct[]
  specifications   DealSpecification[]
  cartItems        DealCartItem[]
  reviews          Review[]
  // Stores related deal ids (`relatedDealIds: string[]`) for the "Related
  // deals" cross-sell on the deal detail page.
  metadata         Json?
  seoTitle         String?            @map("seo_title")
  seoDescription   String?            @map("seo_description")
  seoCanonicalUrl  String?            @map("seo_canonical_url")
  seoOgTitle       String?            @map("seo_og_title")
  seoOgDescription String?            @map("seo_og_description")
  seoImageUrl      String?            @map("seo_image_url")
  seoKeywords      String?            @map("seo_keywords")
  seoNoIndex       Boolean            @default(false) @map("seo_no_index")
  seoSchemaNotes   String?            @map("seo_schema_notes")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([status])
}

// A single product (optionally one specific variant) included in a deal, with
// the number of units that come with the deal. Each included product can only
// appear once per deal (per variant); quantities cannot exceed the linked
// variant's available stock (validated in the admin service).
model DealProduct {
  id               String          @id @default(uuid())
  deal             Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId           String          @map("deal_id")
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String          @map("product_id")
  // When set, the deal unit maps to this specific variant; otherwise it maps
  // to the product's default variant.
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  productVariantId String?         @map("product_variant_id")
  // Number of units of this product included in the deal.
  quantity         Int             @default(1)
  position         Int             @default(0)
  createdAt        DateTime        @default(now()) @map("created_at")

  @@unique([dealId, productId, productVariantId])
  @@index([dealId])
  @@index([productId])
  @@index([productVariantId])
}

// Deal-level specifications (mirrors ProductSpecification).
model DealSpecification {
  id        String   @id @default(uuid())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId    String   @map("deal_id")
  key       String
  value     String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([dealId])
}

model DealImage {
  id        String   @id @default(uuid())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId    String   @map("deal_id")
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([dealId, position])
}

model ProductSpecification {
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @map("product_id")
  key       String
  value     String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
}

model Review {
  id               String       @id @default(uuid())
  // Review target: exactly one of `product` or `deal` must be set (enforced in
  // the service layer). Reviews for a deal cover the whole bundle.
  product          Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String?      @map("product_id")
  deal             Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId           String?      @map("deal_id")
  user             User?        @relation("AuthorReviews", fields: [userId], references: [id])
  userId           String?      @map("user_id")
  // rating must be between 1 and 5 (validated by DB CHECK constraint)
  rating           Int
  title            String?
  body             String?
  // Deprecated compatibility mirror. Canonical moderation state lives in `status`,
  // and writers must keep this synced as `status == APPROVED`.
  approved         Boolean      @default(false)
  status           ReviewStatus @default(PENDING)
  moderationReason String?      @map("moderation_reason")
  moderatedAt      DateTime?    @map("moderated_at")
  moderatedById    String?      @map("moderated_by_id")
  moderatedBy      User?        @relation("ModeratedReviews", fields: [moderatedById], references: [id])
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([productId])
  @@index([dealId])
  @@index([status])
  @@index([productId, status])
  @@index([dealId, status])
}

model Wishlist {
  id        String         @id @default(uuid())
  user      User?          @relation(fields: [userId], references: [id])
  userId    String?        @map("user_id")
  items     WishlistItem[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([userId])
}

model WishlistItem {
  id               String         @id @default(uuid())
  wishlist         Wishlist       @relation(fields: [wishlistId], references: [id])
  wishlistId       String         @map("wishlist_id")
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String         @map("product_variant_id")
  quantity         Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at")

  // Prevent duplicate wishlist entries for the same wishlist + variant
  @@unique([wishlistId, productVariantId])
  @@index([wishlistId])
}

model Cart {
  id        String     @id @default(uuid())
  token     String?    @unique
  user      User?      @relation(fields: [userId], references: [id])
  userId    String?    @map("user_id")
  status    CartStatus @default(ACTIVE)
  items     CartItem[]
  // Deal bundle lines — a deal is treated as ONE cart line item (quantity
  // controls the whole bundle, not its individual products).
  dealItems DealCartItem[]
  // Abandonment tracking fields — populated by the abandoned-cart service.
  // The background job that sends recovery emails is deferred (future automation).
  abandonedAt         DateTime? @map("abandoned_at")
  recoveryToken       String?   @unique @map("recovery_token")
  recoveryEmailSentAt DateTime? @map("recovery_email_sent_at")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([userId])
}

model CartItem {
  id               String         @id @default(uuid())
  cart             Cart           @relation(fields: [cartId], references: [id])
  cartId           String         @map("cart_id")
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String         @map("product_variant_id")
  quantity         Int            @default(1)
  unitPrice        Int            @map("unit_price") // snapshot of price when added (smallest unit)
  createdAt        DateTime       @default(now()) @map("created_at")

  // Prevent duplicate cart entries for the same cart + variant
  @@unique([cartId, productVariantId])
  @@index([cartId])
}

// A Deal bundle treated as a single cart line. `quantity` = how many copies of
// the whole deal are in the cart; `unitPrice` snapshots the deal price at add
// time. At checkout each deal line expands into order items for every included
// product (see orders service).
model DealCartItem {
  id        String   @id @default(uuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String   @map("cart_id")
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId    String   @map("deal_id")
  quantity  Int      @default(1)
  unitPrice Int      @map("unit_price") // snapshot of deal price when added
  createdAt DateTime @default(now()) @map("created_at")

  // Prevent duplicate cart entries for the same cart + deal
  @@unique([cartId, dealId])
  @@index([cartId])
  @@index([dealId])
}

model Order {
  id                String        @id @default(uuid())
  orderNumber       String        @unique @map("order_number")
  user              User?         @relation(fields: [userId], references: [id])
  userId            String?       @map("user_id")
  status            OrderStatus   @default(PENDING)
  subtotal          Int
  shipping          Int
  tax               Int
  discount          Int
  total             Int
  currency          Currency      @default(PKR)
  paymentMethod     String?       @map("payment_method")
  paymentProvider   String?       @map("payment_provider")
  paymentStatus     String?       @map("payment_status")
  refundStatus      RefundStatus  @default(NONE)
  placedAt          DateTime      @default(now()) @map("placed_at")
  items             OrderItem[]
  shippingAddress   OrderAddress? @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  shippingAddressId String?       @map("shipping_address_id")
  billingAddress    OrderAddress? @relation("BillingAddress", fields: [billingAddressId], references: [id])
  billingAddressId  String?       @map("billing_address_id")
  metadata          Json?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([orderNumber])
  @@index([userId])
}

model OrderItem {
  id           String   @id @default(uuid())
  order        Order    @relation(fields: [orderId], references: [id])
  orderId      String   @map("order_id")
  productId    String?  @map("product_id") // optional reference to original product
  productName  String   @map("product_name")
  variantTitle String?  @map("variant_title")
  sku          String?
  unitPrice    Int      @map("unit_price")
  quantity     Int
  subtotal     Int
  tax          Int?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([orderId])
}

model OrderAddress {
  id             String   @id @default(uuid())
  fullName       String   @map("full_name")
  phone          String?
  email          String?
  street1        String
  street2        String?
  // Use the shared City enum for consistency with `Address`
  city           City     @default(KARACHI)
  province       String?
  country        Country  @default(PAK)
  postcode       String?
  notes          String?
  shippingOrders Order[]  @relation("ShippingAddress")
  billingOrders  Order[]  @relation("BillingAddress")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  model     String?
  modelId   String?  @map("model_id")
  changes   Json?
  createdAt DateTime @default(now()) @map("created_at")
}

model StoreSettings {
  // Singleton-style settings row. The service always reads/writes the "default" id.
  id                    String   @id
  storeName             String   @map("store_name")
  storeTagline          String?  @map("store_tagline")
  supportEmail          String   @map("support_email")
  supportPhone          String?  @map("support_phone")
  supportWhatsapp       String?  @map("support_whatsapp")
  supportHours          String?  @map("support_hours")
  shippingOriginCity    String   @map("shipping_origin_city")
  shippingFlatRate      Int      @default(250) @map("shipping_flat_rate")
  shippingFreeThreshold Int?     @map("shipping_free_threshold")
  dispatchLeadTimeDays  Int      @default(1) @map("dispatch_lead_time_days")
  lowStockThreshold     Int      @default(5) @map("low_stock_threshold")
  allowBackorders       Boolean  @default(false) @map("allow_backorders")
  metadata              Json?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model HomePageSection {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String
  type      String
  content   Json?
  meta      Json?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Banner {
  id        String    @id @default(uuid())
  title     String
  imageUrl  String    @map("image_url")
  href      String?
  startAt   DateTime? @map("start_at")
  endAt     DateTime? @map("end_at")
  active    Boolean   @default(true)
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
}

model DealCampaign {
  id          String                @id @default(uuid())
  name        String
  description String?
  price       Int?
  compareAt   Int?                  @map("compare_at")
  targetHref  String?               @map("target_href")
  imageUrl    String?               @map("image_url")
  imageAlt    String?               @map("image_alt")
  startsAt    DateTime?             @map("starts_at")
  endsAt      DateTime?             @map("ends_at")
  active      Boolean               @default(true)
  products    DealCampaignProduct[]
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
}

model DealCampaignProduct {
  id         String       @id @default(uuid())
  campaign   DealCampaign @relation(fields: [campaignId], references: [id])
  campaignId String       @map("campaign_id")
  product    Product      @relation(fields: [productId], references: [id])
  productId  String       @map("product_id")

  // Prevent duplicate product entries per campaign
  @@unique([campaignId, productId])
  @@index([campaignId])
  @@index([productId])
}

// Contact form submissions (lead capture)
model ContactSubmission {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([email])
  @@map("contact_submission")
}

// --------------------
// Email marketing
// --------------------

// Standalone subscriber list — not linked to User so guest/anonymous
// subscribers are fully supported without requiring an account.
// Double opt-in (email confirmation) is deferred; new rows land as PENDING.
model EmailSubscriber {
  id    String @id @default(uuid())
  email String @unique

  firstName String? @map("first_name")

  // Where the subscriber was captured.
  // Known values: "checkout", "newsletter_popup", "account_signup", "order_completion".
  // Stored as a plain string so new sources can be added without schema changes.
  source String

  status SubscriberStatus @default(PENDING)

  // Tags for campaign segmentation, e.g. ["newsletter", "restock_alerts"].
  tags String[]

  // Opaque one-time token used in unsubscribe links.
  // NEVER embed the subscriber's email in an unsubscribe URL — always use this token.
  unsubscribeToken String @unique @map("unsubscribe_token")

  confirmedAt    DateTime? @map("confirmed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  // Provider-specific sync metadata (e.g. Mailchimp member ID, Brevo contact ID).
  // Populated by the campaign provider adapter when a live provider is configured.
  providerMeta Json? @map("provider_meta")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("email_subscriber")
}

// Append-only event log for the abandoned cart detection pipeline.
// Intentionally denormalized: cartId, cartToken, userId, and email are all
// stored so this table stays useful even after the Cart row is archived/deleted.
// The background recovery job (cron/queue) that reads and acts on these events
// is deferred — this table provides the data foundation it will need.
model AbandonedCartEvent {
  id        String                 @id @default(uuid())
  cartId    String                 @map("cart_id")
  cartToken String                 @map("cart_token")
  userId    String?                @map("user_id")
  // Customer email when available (guest checkout form or authenticated user profile).
  email     String?
  eventType AbandonedCartEventType @map("event_type")
  // Snapshot metadata: item count, subtotal (paisa), first product name, etc.
  // Allows the recovery job to render a personalized email without re-querying the cart.
  metadata  Json?
  createdAt DateTime               @default(now()) @map("created_at")

  @@index([cartToken])
  @@index([userId])
  @@index([email])
  @@index([eventType])
  @@index([createdAt])
  @@map("abandoned_cart_event")
}

